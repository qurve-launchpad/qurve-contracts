# ── Network ──
RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002
GAS_PRICE=

# 1 USDC (native 18 dec)
INITIAL_LAUNCH_FEE=1000000000000000000

# ── Native / Stablecoin ──
USDC_ERC20_INTERFACE=0x3600000000000000000000000000000000000000
EURC_ERC20=0xbEf5f6d51CB62b58e6A8f77868681825C6fe21c1

# ── Uniswap V3 ──
UNISWAP_V3_FACTORY=0x428175C4CBCC83E305Fa9827Ce896129D60B9319
