UNISWAP_V4_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951

# ⚠️ REQUIRED by AgentSwapRouter (post-graduation entry point).
#    MUST be a SwapRouter02-style contract (NOT Universal Router, NOT
#    SwapRouter v1) — the interface used is exactInputSingle() with a
#    params struct that has NO `deadline` field.
#    If Arc has no SwapRouter02 deployment, either:
#      a) deploy one yourself, or
#      b) check if the Universal Router address above is a SwapRouter02
#         proxy (it usually is not).
#    Leave blank until verified — deploy will fail fast with a clear error.
UNISWAP_V3_SWAP_ROUTER=0x726e7fEF9BF3Ac376895843a98a78Db1817c1DBc

